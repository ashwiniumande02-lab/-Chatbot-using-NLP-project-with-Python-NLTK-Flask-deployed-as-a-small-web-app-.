        "import json\n",
        "\n",
        "class PersonalInfoManager:\n",
        "    def __init__(self, filename=\"pim_data.json\"):\n",
        "        self.filename = filename\n",
        "        self.data = []\n",
        "        self.load()\n",
        "\n",
        "    def add_person(self, name, age, city, hobbies):\n",
        "        person = {\n",
        "            \"id\": len(self.data) + 1,\n",
        "            \"name\": name,\n",
        "            \"age\": age,\n",
        "            \"city\": city,\n",
        "            \"hobbies\": hobbies\n",
        "        }\n",
        "        self.data.append(person)\n",
        "        self.save()\n",
        "\n",
        "    def save(self):\n",
        "        with open(self.filename, \"w\") as f:\n",
        "            json.dump(self.data, f, indent=4)\n",
        "\n",
        "    def load(self):\n",
        "        try:\n",
        "            with open(self.filename, \"r\") as f:\n",
        "                self.data = json.load(f)\n",
        "        except:\n",
        "            self.data = []\n",
        "\n",
        "    def show_all(self):\n",
        "        if not self.data:\n",
        "            print(\"No records found.\")\n",
        "            return\n",
        "\n",
        "        for p in self.data:\n",
        "            print(f\"\"\"\n",
        "------------------------------\n",
        "ID     : {p['id']}\n",
        "Name   : {p['name']}\n",
        "Age    : {p['age']}\n",
        "City   : {p['city']}\n",
        "Hobbies: {\", \".join(p['hobbies'])}\n",
        "------------------------------\n",
        "\"\"\")"
      ],
